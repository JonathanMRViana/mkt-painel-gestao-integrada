NODE_ENV=production
PORT=3000

# Use uma conta tecnica exclusiva. Nao use a senha ADM na aplicacao.
DB_SERVER=SERVIDOR_SQL
DB_PORT=1433
DB_DATABASE=PainelGestaoMakro
DB_USER=painel_makro_app
DB_PASSWORD=ALTERAR_NO_SERVIDOR
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false

# Origem liberada para acessar a API. Separe mais de uma por virgula.
ALLOWED_ORIGINS=https://makroengenharia.com.br

# Chave longa usada apenas para disparar sincronizacao manual.
SYNC_ADMIN_KEY=GERAR_UMA_CHAVE_LONGA_E_ALEATORIA
SYNC_INTERVAL_MINUTES=10
SYNC_ON_START=true

